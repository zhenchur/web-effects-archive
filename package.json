{
  "name": "web-effects-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4191 --strictPort",
    "build": "tsc --noEmit && node scripts/package-effect.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4191 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "deploy": "npm test && npm run build && node scripts/deploy-pages.mjs"
  },
  "dependencies": { "gsap": "3.15.0" },
  "devDependencies": { "typescript": "~5.9.3", "vite": "^6.4.3" }
}
